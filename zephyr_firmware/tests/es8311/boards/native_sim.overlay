/*
 * SPDX-License-Identifier: Apache-2.0
 *
 * native_sim 上的测试接线:
 *   I2C0 挂 ES8311 模拟器, 功放使能接 GPIO 模拟器
 */

#include <zephyr/dt-bindings/gpio/gpio.h>

/ {
	/* 与真实板一致的功放电源开关, 由 ES8311 驱动按播放状态开关 */
	speaker_amp: speaker-amp {
		compatible = "regulator-fixed";
		regulator-name = "ns4150b";
		enable-gpios = <&gpio0 0 GPIO_ACTIVE_HIGH>;
	};
};

&i2c0 {
	/* 板级定义里已有 dummy codec 占用 audio_codec 标签, 这里用器件名作标签 */
	es8311: es8311@18 {
		compatible = "everest,es8311";
		reg = <0x18>;
		pa-supply = <&speaker_amp>;
	};
};
